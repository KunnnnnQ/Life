# Copy to deploy.env (ignored by git). No API keys here: set them with `wrangler secret put` after deploying.

# Cloudflare resources
D1_DATABASE_NAME=mood-capsule
# Optional. Keeps generated images and audio beyond the provider's 24-hour links. Needs R2 enabled in the dashboard.
# R2_BUCKET_NAME=mood-capsule-media

# Custom domain, once the domain's DNS is on Cloudflare (otherwise use the workers.dev address)
# CUSTOM_DOMAIN=app.kunkun24.com

# Text agents: DeepSeek (planner, writer, reviewer, intake)
CONTENT_MODE=live
LLM_PROVIDER=deepseek
# Defaults to deepseek-flash. A stronger reviewer is optional:
# LLM_MODEL_REVIEWER=deepseek-v4-pro

# Images and speech: Alibaba Cloud Model Studio (needs DASHSCOPE_API_KEY as a secret)
# IMAGE_MODEL=wan2.2-t2i-flash
# IMAGES_PER_SESSION=1
# TTS_MODEL=qwen3-tts-flash
# TTS_VOICE=Cherry

# Classroom study with random control groups
# STUDY_MODE=on
